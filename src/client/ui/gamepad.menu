// Regular gamepad configuration

begin gamepad
    title "Gamepad Setup"
    info --default "(none)" "connected gamepad" "$in_gamepad"
    toggle "enable gamepad" in_joystick
    blank
    bindgp "attack" +attack
    bindgp "next weapon/item" cl_weapnext // cl_... for remaster default bindings compatibility
    bindgp "previous weapon/item" cl_weapprev // cl_... for remaster default bindings compatibility
    bindgp "up / jump" +moveup
    bindgp "down / crouch" +movedown
    // Offer some, inventory controls, they're useful for vanilla games...
    bindgp "inventory" inven
    bindgp "use item" invuse
    bindgp "drop item" invdrop
    // bindgp "prev item" invprev
    // bindgp "next item" invnext
    bindgp "help computer" "cmd help"
    bindgp "item wheel" +wheel2
    bindgp "weapon wheel" +wheel
    blank
    toggle "invert look Y axis" joy_invert
    values "stick mode" joy_swapmovelook "left move, right look" "left look, right move"
    blank
    action --align "advanced options..." pushmenu gamepad_advanced
end

begin gamepad_advanced
    title "Gamepad Advanced Options"
    range --precision 3 "look stick deadzone" joy_deadzone_look 0 1 0.001
    range --precision 3 "look stick outer threshold" joy_outer_threshold_look 0 1 0.001
    range "look stick easing exponent" joy_exponent 1 4
    range --precision 0 "look stick yaw sensitivity" joy_sensitivity_yaw 10 500 5
    range --precision 0 "look stick pitch sensitivity" joy_sensitivity_pitch 10 500 5
    toggle "invert look X axis" cl_joyinvertturn
    blank
    range --precision 3 "move stick deadzone" joy_deadzone_move 0 1 0.001
    range --precision 3 "move stick outer threshold" joy_outer_threshold_move 0 1 0.001
    range "move stick easing exponent" joy_exponent_move 1 4
    toggle "invert move forward/backward" cl_joyinvertstrafe
    toggle "invert move left/right" cl_joyinvertmove
    blank
    info "touchpad available" "$in_gamepad_has_touchpad"
    range --precision 3 "touchpad pressure threshold" cl_joytouchpadpressure 0 1 0.001
    blank
    toggle "LED damage color" cl_joydamageblendled
    blank
    bind --keymouse --gamepad "gamepad alternative modifier" +altmodifier
end
